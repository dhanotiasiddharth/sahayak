# --- Sahayak backend ---
PORT=8080
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Connector: mock | tally | sapb1
CONNECTOR=mock

# Tally Prime (XML/HTTP). Tally must have "Enable ODBC/HTTP server" on, default port 9000.
TALLY_URL=http://localhost:9000
TALLY_COMPANY=SFS Industries Private Limited

# SAP Business One Service Layer
SAPB1_URL=https://sap-host:50000/b1s/v1
SAPB1_COMPANYDB=SBODemoIN
SAPB1_USER=manager
SAPB1_PASSWORD=...

# WhatsApp Cloud API (Meta)
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=sahayak-verify

# Postgres (leave empty to use in-memory store for dev)
DATABASE_URL=
